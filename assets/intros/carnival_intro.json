  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1184,
   "text": "I wonder where everyone is?",
   "at": "0x1BB174"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 45,
   "seq": 4,
   "at": "0x1BB17C"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 27,
   "text_offset": 1212,
   "text": "Maybe it's an off night.",
   "at": "0x1BB182"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 4102,
   "text_offset": 1237,
   "text": "Like, that means no waiting in lines!",
   "at": "0x1BB18A"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB192"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1275,
   "text": "Reh!",
   "at": "0x1BB198"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 44,
   "seq": 4,
   "at": "0x1BB1A0"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 29,
   "text_offset": 1280,
   "text": "It's creepy if you ask me.",
   "at": "0x1BB1A6"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 44,
   "seq": 5,
   "at": "0x1BB1AE"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 29,
   "text_offset": 1307,
   "text": "I've seen off nights, but this place is DEAD.",
   "at": "0x1BB1B4"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB1BC"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1353,
   "text": "D-d-dead?",
   "at": "0x1BB1C2"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 4102,
   "text_offset": 1363,
   "text": "Like, boring, Scoob. Unhip, not happening. Get it?",
   "at": "0x1BB1CA"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB1D2"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1414,
   "text": "Oh!",
   "at": "0x1BB1D8"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 71,
   "at": "0x1BB1E0"
  },
  {
   "op": "queue_sound_driver_id",
   "sound_id": 3,
   "at": "0x1BB1E6"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 43,
   "seq": 5,
   "at": "0x1BB1EA"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1418,
   "text": "I'm with Velma. Something feels funny.",
   "at": "0x1BB1F0"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 43,
   "seq": 4,
   "at": "0x1BB1F8"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1457,
   "text": "I don't even see anyone selling tickets.",
   "at": "0x1BB1FE"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 45,
   "seq": 5,
   "at": "0x1BB206"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 27,
   "text_offset": 1498,
   "text": "Oh, stop being a worry wart. All the lights on the rides are on.",
   "at": "0x1BB20C"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 45,
   "seq": 4,
   "at": "0x1BB214"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 27,
   "text_offset": 1563,
   "text": "Let's go.",
   "at": "0x1BB21A"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 43,
   "seq": 5,
   "at": "0x1BB222"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1573,
   "text": "Okay, okay. Shaggy, Scooby, you coming?",
   "at": "0x1BB228"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB230"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1613,
   "text": "Uh UH. No ray.",
   "at": "0x1BB236"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 4102,
   "text_offset": 1628,
   "text": "Like Scooby here's allergic to boats.",
   "at": "0x1BB23E"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB246"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1666,
   "text": "And water!",
   "at": "0x1BB24C"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 44,
   "seq": 4,
   "at": "0x1BB254"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 29,
   "text_offset": 1677,
   "text": "You mean you're both AFRAID of the boats.",
   "at": "0x1BB25A"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 2,
   "seq": 65,
   "at": "0x1BB262"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 25,
   "text_offset": 1719,
   "text": "Uh huh. Rat's right.",
   "at": "0x1BB268"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 4102,
   "text_offset": 1740,
   "text": "Not to mention starved.",
   "at": "0x1BB270"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 43,
   "seq": 5,
   "at": "0x1BB278"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1764,
   "text": "Well, let's meet back here in an hour then, okay?",
   "at": "0x1BB27E"
  },
  {
   "op": "start_anim_sequence_and_wait",
   "channel": 43,
   "seq": 4,
   "at": "0x1BB286"
  },
  {
   "op": "draw_text_message_and_wait",
   "flag_word": 9,
   "text_offset": 1814,
   "text": "Let's go girls.",
   "at": "0x1BB28C"
